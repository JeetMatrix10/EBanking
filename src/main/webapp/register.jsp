<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%
    String ctx = request.getContextPath();
%>
<jsp:include page="/includes/header.jsp">
    <jsp:param name="title" value="Register"/>
    <jsp:param name="nav" value="public"/>
    <jsp:param name="active" value="register"/>
</jsp:include>

<div class="card form-card wide">
    <h1 class="page-title">Create your account</h1>
    <p class="page-sub">Your Customer ID is generated by the bank after you register.</p>

    <%-- The pattern attributes mirror ValidationUtil on the server, so honest
         users get an inline browser message. The server check still runs for
         anyone who bypasses the browser. --%>
    <form action="<%= ctx %>/register" method="post">
        <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" required>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="phone">Phone Number</label>
                <input type="text" id="phone" name="phone" required inputmode="numeric"
                       pattern="[0-9]{10}" maxlength="10" title="Enter a 10-digit mobile number">
            </div>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="panno">PAN Number</label>
                <input type="text" id="panno" name="panno" required maxlength="10"
                       pattern="[A-Za-z]{5}[0-9]{4}[A-Za-z]" title="Format: ABCDE1234F">
            </div>
            <div class="form-group">
                <label for="aadhaarno">Aadhaar Number</label>
                <input type="text" id="aadhaarno" name="aadhaarno" required inputmode="numeric"
                       pattern="[0-9]{12}" maxlength="12" title="Enter the 12-digit Aadhaar number">
            </div>
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required>
        </div>

        <button class="btn btn-primary btn-block" type="submit">Register</button>
    </form>

    <p class="hint mt">Already registered? <a href="<%= ctx %>/login.jsp">Log in</a></p>
</div>

<jsp:include page="/includes/footer.jsp"/>