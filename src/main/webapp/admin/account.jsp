<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<% String ctx = request.getContextPath(); %>
<jsp:include page="/includes/header.jsp">
    <jsp:param name="title" value="Create Account"/>
    <jsp:param name="nav" value="admin"/>
    <jsp:param name="active" value="account"/>
</jsp:include>

<div class="card form-card">
    <h1 class="page-title">Create Account</h1>
    <p class="page-sub">The account number is generated by the system.</p>
    <form action="<%= ctx %>/addAccount" method="post">
        <div class="form-group">
            <label for="cid">Customer ID</label>
            <input type="text" id="cid" name="cid" placeholder="CUST0001" required>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="opendate">Open date</label>
                <input type="date" id="opendate" name="opendate" value="<%= java.time.LocalDate.now() %>" required>
            </div>
            <div class="form-group">
                <label for="accounttype">Account type</label>
                <select id="accounttype" name="accounttype">
                    <option value="Saving">Saving</option>
                    <option value="Current">Current</option>
                </select>
            </div>
        </div>
        <div class="form-group">
            <label for="balance">Initial balance (&#8377;)</label>
            <input type="number" id="balance" name="balance" step="0.01" min="0" required>
        </div>
        <button class="btn btn-primary btn-block" type="submit">Add Account</button>
    </form>
</div>

<jsp:include page="/includes/footer.jsp"/>